# Copy this file to `.env` for local testing (it's gitignored, never committed).
# In production this bot doesn't read .env - GitHub Actions injects these as
# real environment variables from repo Secrets instead. This file is only so
# you can `export $(cat .env | xargs)` and test main.py locally if you want.

GROQ_API_KEY=
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
PUBLIC_IMAGE_BASE_URL=
AUTO_PUBLISH=false
FB_APP_ID=
FB_APP_SECRET=
